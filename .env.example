# ============================================================
# Bola de Neve — variáveis de ambiente
# Copie para `.env` (desenvolvimento) e `.env.test` (testes).
# NUNCA versione arquivos .env com credenciais reais.
# ============================================================

# Conexão PostgreSQL (obrigatória)
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/snowball?schema=public"

# Duração da sessão em horas (opcional, padrão 168 = 7 dias, máx. 720)
# SESSION_TTL_HOURS=168

# Força o atributo Secure do cookie de sessão (opcional).
# Padrão: true quando NODE_ENV=production, false caso contrário.
# Só defina "false" em produção se estiver testando localmente via HTTP.
# SESSION_COOKIE_SECURE=true

# ------------------------------------------------------------
# Integrações (Etapa 3) — ver DOCUMENTATION/INTEGRATIONS.md
# ------------------------------------------------------------

# Liga/desliga todas as consultas externas (padrão: true).
# INTEGRATIONS_ENABLED=true

# Chave da brapi (https://brapi.dev/dashboard). Opcional.
# Sem chave, a brapi só libera dados de teste (FIIs MXRF11 e HGLG11; cotação
# atual de FIIs exige chave). Nunca versione a chave real.
# BRAPI_API_KEY=

# Sem cotação atual liberada pelo plano, usar o último fechamento diário (padrão: true).
# BRAPI_DAILY_CLOSE_FALLBACK=true

# Avisos oficiais de rendimentos na B3 FundosNET (exige CNPJ no fundo; padrão: true).
# FUNDOSNET_ENABLED=true

# Cotação marcada como desatualizada após N horas úteis (padrão: 24).
# QUOTE_STALE_AFTER_BUSINESS_HOURS=24

# Cache em memória das cotações, em segundos (padrão: 900).
# QUOTE_CACHE_TTL_SECONDS=900

# Segredo (mín. 32 caracteres) para /api/cron/refresh. Sem ele, o endpoint fica desabilitado.
# CRON_SECRET=
